# The domain part of the namespace label keys in the developer onboarding guide and checklist,
# e.g. LABEL_DOMAIN=company.net renders "company.net/mnemonic" and "company.net/app-environment".
# To change it: edit the value below, run docs/onboarding/render.sh, commit this file and the three rendered docs.
LABEL_DOMAIN=company.net
# The date stamped on docs/ONBOARDING.docx (YYYY-MM-DD). Fixed, so the Word file is byte-reproducible and CI can
# compare it; move it forward when the guide's content changes.
DOC_DATE=2026-10-14
